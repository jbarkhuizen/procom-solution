# Procom Solutions -- production environment. Lives at /opt/procom/app/.env
# (never committed). Fill secrets in directly on the server; never paste them
# into chat or any AI tool.

PORT=8788
HOST=127.0.0.1
SITE_URL=https://www.procompretoria.co.za
API_URL=https://www.procompretoria.co.za

# --- Payfast -------------------------------------------------------------
# sandbox | live. Start in sandbox, place a test order, then switch.
PAYFAST_MODE=sandbox
# Live merchant account (can be the same Payfast account Lapanza uses)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Your own Payfast sandbox account (recommended -- the shared public demo
# account can't be signed, so Payfast's payment notifications won't verify).
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_MERCHANT_KEY=
PAYFAST_SANDBOX_PASSPHRASE=

# --- Email (Gmail SMTP with an App Password) -----------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
